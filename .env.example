# Copy this file to .env in the project root and replace these placeholders.
# URL-encode special characters in the username and password.
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/blockchain_certificates?schema=public"

# Development seed only: choose 12+ characters, at most 72 UTF-8 bytes.
DEMO_ADMIN_PASSWORD=""

# Public site origin encoded in certificate QR codes.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Sepolia configuration. Never use NEXT_PUBLIC_ for these settings.
SEPOLIA_RPC_URL=""
BLOCKCHAIN_PRIVATE_KEY=""
CERTIFICATE_CONTRACT_ADDRESS=""

# SMTP notifications (server-only). Local capture server: 127.0.0.1:1025.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
