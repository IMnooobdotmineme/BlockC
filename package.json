{
  "name": "blockchain-certificate-verification-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "prebuild": "prisma generate",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:check": "tsx scripts/check-database.ts",
    "db:seed": "prisma db seed",
    "blockchain:compile": "cd blockchain && hardhat compile",
    "blockchain:test": "cd blockchain && hardhat test",
    "blockchain:typecheck": "tsc --project blockchain/tsconfig.json",
    "blockchain:deploy": "tsx scripts/deploy-contract.ts",
    "blockchain:hash-test": "tsx --test scripts/test-certificate-hash.ts",
    "blockchain:check": "node --conditions=react-server --import tsx scripts/check-blockchain.ts",
    "email:dev": "tsx scripts/local-smtp.ts",
    "security:scan": "node scripts/check-secrets.mjs",
    "pretest:integration": "npm run blockchain:compile && npm run build",
    "test:integration": "node --conditions=react-server --import tsx --test scripts/test-blockchain-integration.mts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.5",
    "ethers": "^6.17.0",
    "next": "16.3.8",
    "nodemailer": "^10.0.15",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@nomicfoundation/hardhat-ethers": "^4.2.0",
    "@nomicfoundation/hardhat-node-test-runner": "^3.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/smtp-server": "^3.5.13",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "hardhat": "^3.18.1",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^6.4.299",
    "pngjs": "^7.0.0",
    "prisma": "^7.10.0",
    "smtp-server": "^3.19.17",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
